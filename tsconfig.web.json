{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/**/*",
    "src/preload/**/*",
    "src/main/llmProviders/types.ts",
    "src/main/llmProviders/ProviderConstants.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "typeRoots": ["./node_modules/@types"],
    "moduleResolution": "bundler",
    "paths": {
      "@renderer/*": [
        "./src/renderer/*"
      ],
      "@llmTypes": [
        "./src/main/llmProviders/types.ts"
      ]
    }
  }
}
